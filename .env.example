# Neon PostgreSQL + pgvector Connection String
DATABASE_URL=postgresql://username:password@ep-broad-brook-aexnflhy-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require

# Spring Boot Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-broad-brook-aexnflhy-pooler.c-2.us-east-2.aws.neon.tech:5432/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_db_password

# Google Gemini LLM API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Outbound Registered Email SMTP Configuration (e.g. Gmail SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-16-character-app-password
